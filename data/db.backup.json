    "story": {
      "title": "Kutoka Tarime Hadi Dar es Salaam — Hadithi ya Lilian",
      "chapters": [
        {
          "badge": "Utotoni & Asili",
          "title": "Mwanzo Wenye Baraka — Tarime, Mara",
          "icon": "🌄",
          "text": "Lilian alizaliwa na kulelewa katika mji wa Tarime, Mkoa wa Mara — ardhi yenye mandhari tulivu, heshima na mila imara. Tangu utotoni, Lilian alikuwa mtoto mwenye furaha, mnyenyekevu, mwenye tabasamu la upendo na mwenye bidii ya kipekee katika masomo na malezi ya wazazi wake."
        },
        {
          "badge": "Ndoto & Hatua Mpya",
          "title": "Safari ya Kuelekea Dar es Salaam",
          "icon": "🏙️",
          "text": "Kipindi kilipofika cha kujiendeleza kimaisha, safari yake ilimleta jijini Dar es Salaam. Akiwa na heshima, maadili na sala za familia yake kutoka Tarime, Lilian alikabiliana na maisha ya jiji kwa ujasiri na bidii kubwa ya kufanikisha ndoto zake."
        },
        {
          "badge": "Kazi & Mafanikio",
          "title": "Kazi na Kujituma Jijini Dar",
          "icon": "💼",
          "text": "Kwa uadilifu na uchapakazi hodari, Lilian alifanikiwa kupata kazi nzuri jijini Dar es Salaam. Alijituma kwa weledi wa hali ya juu na kuaminika sana, akiwa kielelezo cha binti mwenye nidhamu na anayeleta fahari kwa wazazi na jamii yake."
        },
        {
          "badge": "Upendo wa Dhati",
          "title": "Kupata Mchumba (Kelvin)",
          "icon": "💍",
          "text": "Akiwa jijini Dar es Salaam, Mungu aliunganisha hatua zake na Kelvin — mchumba mwenye upendo, staha na maono ya maisha. Upendo wao ulichanua kwa heshima, ucheshi na sala, hadi siku Kelvin alipoweka agano la uchumba kwa ahadi ya kuanza safari ya milele pamoja."
        },
        {
          "badge": "Usiku wa Send-Off",
          "title": "Send-Off ya Kifahari — 13 Oktoba",
          "icon": "👑",
          "text": "Na sasa, tarehe 13 mwezi wa 10 (13 Oktoba 2026), katika ukumbi wa kifahari wa Mlimani City Hall, Dar es Salaam, familia, ndugu na Kamati yote wanakusanyika kwa furaha na vigelegele kumuaga binti yao mpendwa Lilian kuelekea maisha mapya ya ndoa!"
        }
      ]
    }
  },
